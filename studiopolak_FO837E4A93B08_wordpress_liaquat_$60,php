add_action('wp_ajax_load_lab_publications', 'load_lab_publications');
add_action('wp_ajax_nopriv_load_lab_publications', 'load_lab_publications');

function load_lab_publications() {
    $tag = intval($_POST['tag']);

    if (!$tag) {
        wp_send_json_error('No tag provided');
    }

    $html = do_shortcode('[tplist tag="'.$tag.'" limit="5"]');

    wp_send_json_success($html);
}

function lab_ajax_ui() {

    $labs = [
        20 => 'AI-FAIR Lab',
        66 => 'AI for Parkinson Lab',
        43 => 'AI4MRI Lab',
        54 => 'AIMS Lab',
        39 => 'Bioinformatics Lab',
    ];

    ob_start();
    ?>

    <div id="lab-buttons">
        <?php foreach ($labs as $tag => $name): ?>
            <button class="lab-btn" data-tag="<?php echo $tag; ?>">
                <?php echo $name; ?>
            </button>
        <?php endforeach; ?>
    </div>

    <div id="lab-results">
        <p>Select a lab to load publications</p>
    </div>

    <?php
    return ob_get_clean();
}

add_shortcode('lab_ajax', 'lab_ajax_ui');

